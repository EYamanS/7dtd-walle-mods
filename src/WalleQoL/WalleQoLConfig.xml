<!-- WalleQoL: set enabled="false" to turn a feature off (takes effect on next game start). -->
<WalleQoL>
	<!-- Multiple players can use the same container at once.
	     Must be installed on the host/server AND all players.
	     Scope toggles:
	       playerStorage - chests and other containers you placed (default ON, stable)
	       worldLoot     - cabinets, cars, crates, any lootable block (EXPERIMENTAL, default off)
	       workstations  - forge, workbench, chemistry, mixer... (EXPERIMENTAL, default off)
	       droppedBags   - dropped backpacks, loot bags, crates (EXPERIMENTAL, default off) -->
	<feature name="SharedContainers" enabled="true"
	         playerStorage="true" worldLoot="false" workstations="false" droppedBags="false" />
	<!-- Adds a "Deposit items" command to the hold-E radial menu of player-placed containers:
	     tops up existing stacks in the container from your backpack without opening it
	     (same as the single-arrow button inside). Respects your locked backpack slots. -->
	<feature name="QuickDeposit" enabled="true" />
	<!-- Crafting (and item repair) pulls missing ingredients from YOUR placed storage within
	     range meters. Backpack/toolbelt are consumed first; container locks and user-locked
	     container slots are respected; world loot is never touched. Trader/vending/lockpick
	     costs always come from your real inventory (by design).
	       range  - scan radius in meters (max 50)
	       repair - item repair may also pull repair materials from storage
	       forge  - forge recipes may consume raw smeltables from chests at material value
	                (smelted bank units are always used first; leftover units from consumed
	                items are credited into the forge bank, nothing is wasted) -->
	<feature name="CraftFromContainers" enabled="true" range="15" repair="true" forge="true" />
</WalleQoL>
